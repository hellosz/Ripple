# Database
DATABASE_URL=postgresql+asyncpg://ripple:ripple@localhost:5432/ripple
DB_AUTO_INIT_ON_STARTUP=false

# JWT
JWT_SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Admin
ADMIN_EMAIL=admin@patpat.com
ADMIN_PASSWORD=admin123456

# Git Repository
SKILLS_REPO_PATH=/path/to/ripple/skills
GIT_REMOTE_URL=

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Email SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@patpat.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@patpat.com

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ripple
MINIO_SECRET_KEY=ripple123456
MINIO_BUCKET=ripple-skill-packages
MINIO_SECURE=false

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# App
APP_NAME=Ripple
APP_ENV=development
