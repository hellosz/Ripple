{
  "name": "@ripple/monorepo",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "env": "sh -c 'test -f apps/server/.env && echo \"apps/server/.env already exists, skipping\" || (cp apps/server/.env.example apps/server/.env && echo \"Created apps/server/.env\")'",
    "dev": "concurrently -n server,web -c green,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --dir apps/server dev",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:desktop": "pnpm --dir apps/desktop dev",
    "db:generate": "pnpm --dir apps/server db:generate",
    "db:upgrade": "pnpm --dir apps/server db:upgrade",
    "db:stamp-baseline": "pnpm --dir apps/server db:stamp-baseline",
    "lint": "eslint .",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "changeset": "changeset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@fission-ai/openspec",
      "electron",
      "electron-winstaller"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.30.0",
    "@fission-ai/openspec": "^1.2.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "bcryptjs": "^3.0.2",
    "chrome-devtools-mcp": "^0.20.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.30.0",
    "fflate": "^0.8.2",
    "pg": "^8.14.0",
    "playwright": "^1.58.2",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
